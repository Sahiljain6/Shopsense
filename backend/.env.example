# Bounded retailer snapshot cache (process-local; no shared cache infrastructure required)
LIVE_SEARCH_CACHE_TTL_SECONDS=900
LIVE_SEARCH_CACHE_MAX_ENTRIES=256

# AI request and provider/model fallback deadlines
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_CHAIN_TIMEOUT_SECONDS=75
